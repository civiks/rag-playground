# Copy to .env and fill in your keys.

# --- LLM providers ---
GOOGLE_API_KEY=          # Gemini — free at https://aistudio.google.com/apikey
GROQ_API_KEY=            # Groq (free tier) — https://console.groq.com/keys
# Ollama: no key needed, run `ollama serve` locally

# --- Vector store ---
# Leave blank to use embedded Qdrant at data/qdrant/ (local development).
# Set to Qdrant Cloud URL for hosted deployment.
QDRANT_URL=
QDRANT_API_KEY=

# --- Observability ---
# Set to 1 to disable Phoenix tracing (used by eval.py and Streamlit Cloud).
RAG_NO_TRACE=
